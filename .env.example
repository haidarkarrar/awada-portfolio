PORT=3002

# Option A: share one root folder with "Anyone with the link" as Viewer.
# Its child folders are matched to portfolio sections by folder name.
GOOGLE_DRIVE_ROOT_FOLDER=

# Option B: for private folders, share each folder with the service account below.
# You can enter a folder ID or the full https://drive.google.com/drive/folders/... URL.
GOOGLE_DRIVE_FOLDER_TALKING_HEAD=
GOOGLE_DRIVE_FOLDER_REELS=
GOOGLE_DRIVE_FOLDER_BRANDING=
GOOGLE_DRIVE_FOLDER_VIDEO_EDITING=
GOOGLE_DRIVE_FOLDER_SOCIAL_MEDIA=

# Either point to the downloaded service-account JSON file, or provide its
# email and private key below. Keep credentials private; do not commit them.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account.json
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Google Drive is checked every 60 seconds while the site is running.
